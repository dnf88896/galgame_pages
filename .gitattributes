# 统一换行符：仓库内一律存 LF，避免 Windows/Linux 两边 diff 满屏通红。
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则某些解析器会出错。
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制文件：不做换行转换、不做文本 diff。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.jar   binary
*.zip   binary
*.rar   binary
*.woff  binary
*.woff2 binary
